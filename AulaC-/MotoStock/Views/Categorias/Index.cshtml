@model IEnumerable<MotoStock.Models.Categoria>

@{
    ViewData["Title"] = "Categorias de Motas";
}

<style>
    .categoria-card {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 15px;
        border: 3px solid #f1c40f;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .categoria-card h2 {
        color: #f1c40f;
        margin-bottom: 0.5rem;
    }
    .btn-categoria {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
        color: #fff;
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: bold;
        text-transform: uppercase;
    }
    .btn-categoria:hover {
        transform: scale(1.05);
    }
    .piada-categoria {
        background: #e67e22;
        color: #fff;
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        font-style: italic;
        border-left: 5px solid #d35400;
    }
    .vazio-card {
        background: #f8f9fa;
        border: 2px dashed #e67e22;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
    }
</style>

<div class="container mt-4">
    <div class="piada-categoria">
        <strong>😂 Piada da categoria:</strong><br>
        Por que é que a categoria de motas foi ao psicólogo?<br>
        Porque não sabia em que categoria se encaixava! 🤔
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="categoria-card" style="display:inline-block;">
            <h2>📂 Categorias de Motas</h2>
        </div>
        <a class="btn btn-categoria" asp-action="Create">➕ Nova Categoria</a>
    </div>

    @if (!Model.Any())
    {
        <div class="vazio-card">
            <h3>😅 Ainda não há categorias cadastradas!</h3>
            <p class="lead">As motas estão todas sem categoria. Vamos arrumar isso!</p>
            <a class="btn btn-categoria" asp-action="Create">Criar Primeira Categoria</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nome da Categoria</th>
                    <th>Descrição</th>
                    <th>Estado</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                        <td>@(item.Ativo ? "<span class='badge bg-success'>Ativa ✅</span>" : "<span class='badge bg-danger'>Inativa ❌</span>")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">🔍 Detalhes</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">✏️ Editar</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">🗑️ Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="text-center mt-4">
        <a class="btn btn-outline-warning" asp-action="Index" asp-controller="Home">⬅️ Voltar à Garagem</a>
    </div>
</div>
