@model MotoStock.Models.Fornecedor

@{
    ViewData["Title"] = "Detalhes do Fornecedor";
}

<style>
    .detalhes-fornecedor {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 20px;
        padding: 2rem;
        border: 3px solid #f1c40f;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .detalhes-fornecedor h2 {
        color: #f1c40f;
    }
    .info-item {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1rem;
        border-left: 4px solid #e74c3c;
    }
</style>

<div class="container mt-4">
    <div class="detalhes-fornecedor">
        <h2>🚚 Detalhes do Fornecedor: @Html.DisplayFor(model => model.Nome)</h2>
        
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="info-item">
                    <strong>📛 Nome:</strong> @Html.DisplayFor(model => model.Nome)<br>
                    <strong>🆔 NIF:</strong> @Html.DisplayFor(model => model.NIF)<br>
                    <strong>📧 Email:</strong> @Html.DisplayFor(model => model.Email)<br>
                    <strong>📞 Telefone:</strong> @Html.DisplayFor(model => model.Telefone)
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <strong>🏠 Morada:</strong> @Html.DisplayFor(model => model.Morada)<br>
                    <strong>📮 Código Postal:</strong> @Html.DisplayFor(model => model.CodigoPostal)<br>
                    <strong>🏙️ Localidade:</strong> @Html.DisplayFor(model => model.Localidade)<br>
                    <strong>📅 Data de Registo:</strong> @Html.DisplayFor(model => model.DataRegisto)<br>
                    <strong>⚡ Estado:</strong> @(Model.Ativo ? "Ativo ✅" : "Inativo ❌")
                </div>
            </div>
        </div>

        <div class="piada-fornecedor mt-4">
            <strong>😂 Piada:</strong><br>
            O que é que um fornecedor de motas diz ao cliente?<br>
            "Leva esta mota, que ela não te deixa parado!"
        </div>

        <div class="d-grid gap-2 mt-4">
            <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">✏️ Editar Fornecedor</a>
            <a class="btn btn-outline-light" asp-action="Index">⬅️ Voltar à Lista</a>
        </div>
    </div>
</div>

<style>
    .piada-fornecedor {
        background: #e67e22;
        color: #fff;
        padding: 1rem;
        border-radius: 10px;
        font-style: italic;
        border-left: 5px solid #d35400;
        max-width: 500px;
    }
</style>
