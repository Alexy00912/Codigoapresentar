@model IEnumerable<MotoStock.Models.Motocicleta>

@{
    ViewData["Title"] = "As Nossas Motas";
}

<style>
    .moto-card {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 15px;
        border: 3px solid #f1c40f;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .moto-card h2 {
        color: #f1c40f;
        margin-bottom: 0.5rem;
    }
    .btn-moto {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
        color: #fff;
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: bold;
        text-transform: uppercase;
    }
    .btn-moto:hover {
        transform: scale(1.05);
    }
    .piada-moto {
        background: #e67e22;
        color: #fff;
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        font-style: italic;
        border-left: 5px solid #d35400;
    }
    .vazio-card {
        background: #f8f9fa;
        border: 2px dashed #e67e22;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
    }
    .estado-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: bold;
        color: #fff;
    }
    .estado-disponivel { background: #27ae60; }
    .estado-reservada { background: #f39c12; }
    .estado-vendida { background: #c0392b; }
    .estado-preparacao { background: #3498db; }
    .estado-indisponivel { background: #7f8c8d; }
</style>

<div class="container mt-4">
    <div class="piada-moto">
        <strong>😂 Piada da mota:</strong><br>
        Por que é que a mota foi ao médico?<br>
        Porque estava com "motite" aguda! 😂
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="moto-card" style="display:inline-block;">
            <h2>🏍️ As Nossas Motas</h2>
        </div>
        <a class="btn btn-moto" asp-action="Create">➕ Nova Mota</a>
    </div>

    @if (!Model.Any())
    {
        <div class="vazio-card">
            <h3>😅 Ainda não há motas cadastradas!</h3>
            <p class="lead">A garagem está vazia. Vamos registar a primeira mota!</p>
            <a class="btn btn-moto" asp-action="Create">Registar Primeira Mota</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Modelo</th>
                    <th>Marca</th>
                    <th>Categoria</th>
                    <th>Fornecedor</th>
                    <th>Ano</th>
                    <th>Estado</th>
                    <th>Nº Quadro</th>
                    <th>Preço Venda</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Marca.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Categoria.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fornecedor.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ano)</td>
                        <td>
                            <span class="estado-badge @($"estado-{item.Estado.ToString().ToLower()}")">
                                @item.Estado
                            </span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.NumeroQuadro)</td>
                        <td>@Html.DisplayFor(modelItem => item.PrecoVenda) €</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">🔍 Detalhes</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">✏️ Editar</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">🗑️ Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="text-center mt-4">
        <a class="btn btn-outline-warning" asp-action="Index" asp-controller="Home">⬅️ Voltar à Garagem</a>
    </div>
</div>
