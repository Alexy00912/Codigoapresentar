@model MotoStock.Models.Motocicleta

@{
    ViewData["Title"] = "Eliminar Motocicleta";
}

<style>
    .eliminar-moto {
        background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
        color: #fff;
        border-radius: 20px;
        padding: 2rem;
        border: 4px solid #000;
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        text-align: center;
    }
    .eliminar-moto h2 {
        color: #fff;
        font-size: 2.5rem;
    }
    .moto-triste {
        font-size: 4rem;
        display: block;
        margin-bottom: 1rem;
    }
    .btn-confirma {
        background: #f1c40f;
        color: #000;
        border: none;
        border-radius: 30px;
        padding: 1rem 2.5rem;
        font-weight: bold;
        text-transform: uppercase;
    }
    .btn-cancela {
        background: #34495e;
        color: #fff;
        border: none;
        border-radius: 30px;
        padding: 1rem 2.5rem;
        font-weight: bold;
        text-transform: uppercase;
        margin-left: 1rem;
    }
</style>

<div class="container mt-4">
    <div class="eliminar-moto">
        <div class="moto-triste">😢</div>
        <h2>Eliminar Motocicleta?</h2>
        <h3 class="mt-3">Tens a certeza de que queres eliminar a mota <strong>@Html.DisplayFor(model => model.Modelo)</strong>?</h3>
        
        <div class="piada-moto mt-4">
            <strong>😂 Piada:</strong><br>
            Por que é que a mota foi eliminada?<br>
            Porque não dava mais "mota"! 🏍️💨
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                <button type="submit" class="btn-confirma">🗑️ Sim, Eliminar</button>
                <a class="btn-cancela" asp-action="Index">❌ Não, Voltar</a>
            </div>
        </form>
    </div>
</div>

<style>
    .piada-moto {
        background: #e67e22;
        color: #fff;
        padding: 1rem;
        border-radius: 10px;
        font-style: italic;
        border-left: 5px solid #d35400;
        max-width: 400px;
        margin: 0 auto;
    }
</style>
