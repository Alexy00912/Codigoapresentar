@{
    ViewData["Title"] = "Pit Stop 🏍️";
}

<style>
    .moto-card {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 15px;
        border: 4px solid #e74c3c;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .moto-card h1 {
        color: #f39c12;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    .vroom {
        font-size: 3rem;
        animation: @@keyframes vroom 0.5s infinite alternate;
        display: inline-block;
    }
    @@keyframes vroom {
        from { transform: translateX(0); }
        to { transform: translateX(10px); }
    }
    .piada {
        background: #f1c40f;
        color: #000;
        padding: 1rem;
        border-radius: 10px;
        font-style: italic;
        border-left: 5px solid #e67e22;
    }
    .btn-moto {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
        color: #fff;
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: bold;
        text-transform: uppercase;
        transition: all 0.3s;
    }
    .btn-moto:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
    }
    .roda {
        width: 60px;
        height: 60px;
        border: 8px solid #34495e;
        border-top: 8px solid #e74c3c;
        border-radius: 50%;
        animation: @@keyframes spin 1s linear infinite;
        margin: 0 auto;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="text-center mt-5">
    <div class="roda mb-4"></div>

    <div class="moto-card p-5 mb-5">
        <h1 class="display-4">🏍️ PIT STOP 🏍️</h1>
        <p class="lead">Bem-vindo ao espaço de descanso do MotoStock!</p>

        <div class="vroom">VROOOM!</div>

        <div class="piada mt-4">
            <strong>💬 Piada da oficina:</strong><br>
            Por que a motocicleta foi ao médico?<br>
            Porque estava com <em>motite</em> aguda! 😂
        </div>

        <div class="row mt-5 justify-content-center">
            <div class="col-md-6">
                <div class="card bg-dark text-light">
                    <div class="card-body">
                        <h5 class="card-title">🛠️ Oficina do MotoStock</h5>
                        <p class="card-text">Aqui não consertamos motos, só gerimos o stock delas! 
                        Mas se quiseres, pode fingir que esta é uma oficina.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-warning text-dark">
                    <div class="card-body">
                        <h5 class="card-title">⚠️ Aviso Importante</h5>
                        <p class="card-text">Não tente acelerar nesta página. 
                        Limite de velocidade: 0 km/h.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a class="btn-moto" asp-action="Index" asp-controller="Home">
                ⬅️ Voltar à Garagem
            </a>
            <a class="btn btn-outline-light ms-2" asp-controller="Motocicletas" asp-action="Index">
                Ver o Inventário 📋
            </a>
        </div>
    </div>

    <footer class="mt-5 text-muted small">
        MotoStock &copy; 2026 - Nenhuma moto foi prejudicada na criação desta página.
    </footer>
</div>
