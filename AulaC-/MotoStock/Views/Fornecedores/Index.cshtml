@model IEnumerable<MotoStock.Models.Fornecedor>

@{
    ViewData["Title"] = "Fornecedores de Motas";
}

<style>
    .fornecedor-card {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        border-radius: 15px;
        border: 3px solid #f1c40f;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .fornecedor-card h2 {
        color: #f1c40f;
        margin-bottom: 0.5rem;
    }
    .btn-fornecedor {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
        color: #fff;
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: bold;
        text-transform: uppercase;
    }
    .btn-fornecedor:hover {
        transform: scale(1.05);
    }
    .piada-fornecedor {
        background: #e67e22;
        color: #fff;
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        font-style: italic;
        border-left: 5px solid #d35400;
    }
    .vazio-card {
        background: #f8f9fa;
        border: 2px dashed #e67e22;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
    }
</style>

<div class="container mt-4">
    <div class="piada-fornecedor">
        <strong>😂 Piada do fornecedor:</strong><br>
        Por que é que o fornecedor de motas é tão simpático?<br>
        Porque ele quer vender-vos uma "mota" de confiança! 🤝
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="fornecedor-card" style="display:inline-block;">
            <h2>🚚 Fornecedores de Motas</h2>
        </div>
        <a class="btn btn-fornecedor" asp-action="Create">➕ Novo Fornecedor</a>
    </div>

    @if (!Model.Any())
    {
        <div class="vazio-card">
            <h3>😅 Ainda não há fornecedores cadastrados!</h3>
            <p class="lead">Quem nos vai vender as motas? Vamos cadastrar um fornecedor!</p>
            <a class="btn btn-fornecedor" asp-action="Create">Criar Primeiro Fornecedor</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>NIF</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Localidade</th>
                    <th>Estado</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.NIF)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Localidade)</td>
                        <td>@(item.Ativo ? "<span class='badge bg-success'>Ativo ✅</span>" : "<span class='badge bg-danger'>Inativo ❌</span>")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">🔍 Detalhes</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">✏️ Editar</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">🗑️ Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="text-center mt-4">
        <a class="btn btn-outline-warning" asp-action="Index" asp-controller="Home">⬅️ Voltar à Garagem</a>
    </div>
</div>
